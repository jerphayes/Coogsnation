{
  "name": "coogsnation",
  "version": "3.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild server/migrate.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/migrate.js",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "check:server": "tsc --noEmit --project tsconfig.server.json",
    "validate": "npm run check && npm run ui:check && npm run security:check && node scripts/seo-contract-check.mjs && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:bootstrap": "drizzle-kit push",
    "db:migrate": "node dist/migrate.js",
    "db:migrate:dev": "tsx server/migrate.ts",
    "db:push": "drizzle-kit push",
    "auth:doctor": "node scripts/auth-doctor.mjs",
    "security:check": "node scripts/auth-runtime-regression.mjs && node scripts/security-regression.mjs && node scripts/admin-dashboard-regression.mjs && node scripts/v3-ai-router-regression.mjs && node scripts/portable-regression.mjs && node scripts/universal-ai-regression.mjs && node scripts/infrastructure-regression.mjs && tsx scripts/schema-security-check.ts && tsx scripts/profile-form-contract-check.ts && tsx scripts/admin-middleware-check.ts && tsx scripts/auth-regression-check.ts && tsx scripts/universal-ai-check.ts && node scripts/lounge-visual-regression.mjs && node scripts/level4-security-regression.mjs && node scripts/admin-mfa-ui-wiring-regression.mjs && node scripts/getem-regression.mjs && node scripts/getem-control-room-regression.mjs && npm run ai:check && npm run member-mfa:check && npm run security-consistency:check && npm run member-security-controls:check && npm run password-recovery:check && npm run passport-session-race:check",
    "portable:check": "node scripts/portable-regression.mjs",
    "ai:check": "node scripts/ai-regression.mjs && tsx scripts/ai-config-check.ts",
    "audit:prod": "npm audit --omit=dev",
    "admin:bootstrap": "tsx scripts/bootstrap-owner.ts",
    "venue:conformance": "node scripts/venue-engine/conformance.mjs",
    "venue:smoke": "node scripts/venue-engine/smoke.mjs",
    "venue:basketball": "node scripts/venue-engine/basketball-acceptance.mjs",
    "venue:integration": "node scripts/venue-engine/integration.mjs",
    "venue:check": "npm run venue:conformance && npm run venue:smoke && npm run venue:basketball && npm run venue:integration && npm run venue:bridge",
    "venue:bridge": "node scripts/venue-engine/bridge-check.mjs",
    "codespace:start": "bash scripts/codespace-start.sh",
    "sports:check": "node scripts/ngf-sports/check.mjs",
    "sports:smoke": "npm exec tsx -- scripts/ngf-sports/live-source-smoke.ts",
    "ui:check": "node scripts/ui-popup-regression.mjs && npm run participation:check",
    "participation:check": "node scripts/universal-participation-contract-check.mjs",
    "member-mfa:check": "node scripts/member-mfa-contract-check.mjs",
    "security-consistency:check": "node scripts/security-consistency-check.mjs",
    "member-security-controls:check": "node scripts/member-security-controls-check.mjs",
    "password-recovery:check": "node scripts/password-recovery-contract-check.mjs",
    "passport-session-race:check": "node scripts/passport-session-race-check.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
