    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "framer-motion": "^11.13.1",
    "helmet": "8.1.0",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
