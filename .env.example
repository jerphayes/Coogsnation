# Core runtime
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/coogsnation
SESSION_SECRET=replace-with-a-long-random-secret
# REQUIRED in production: exact public origin used by CSRF and Socket.IO checks.
# Example: https://coogsnation.com (no trailing slash)
APP_ORIGIN=http://localhost:5000
APP_DOMAIN=localhost

# Replit OIDC remains optional only after the planned auth portability refactor
REPLIT_DOMAINS=localhost
REPL_ID=
ISSUER_URL=https://replit.com/oidc

# Optional social login providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional integrations
OPENAI_API_KEY=
AI_ENABLED=false
RECAPTCHA_SECRET_KEY=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PRINTFUL_API_KEY=
TEELAUNCH_API_KEY=
TRENDSI_API_KEY=
