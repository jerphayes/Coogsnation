# Core runtime
NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:5000
APP_DOMAIN=
# Configure proxy trust per host: false, true, a hop count, or a proxy subnet.
TRUST_PROXY=false

# PostgreSQL (standard PostgreSQL; works locally or with any managed provider)
# This localhost value is for manual/Codespaces development. Docker Compose
# overrides DATABASE_URL inside containers so the host becomes `database`.
# Replace it with the exact managed PostgreSQL URL in production.
DATABASE_URL=postgresql://coogs:coogs_dev_password@localhost:5432/coogsnation
POSTGRES_HOST_PORT=5432
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Sessions
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=coogsnation.sid

# Portable filesystem storage. Point this to a persistent mounted volume in production.
DATA_DIR=./data
UPLOADS_DIR=./data/uploads

# Optional social login providers. Email/password login works without these.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# CoogsNation Public AI v3.0 router
# OpenAI is the primary conversational provider. Gemini is an optional,
# separately keyed multimedia specialist. Neither tier can inherit ADMIN_AI_*.
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-nano
AI_BASE_URL=https://api.openai.com/v1
# Generic key overrides provider-specific public keys below.
AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
CUSTOM_AI_API_KEY=
ANTHROPIC_VERSION=2023-06-01

# Router behavior
AI_ROUTER_DEFAULT=primary
AI_ROUTER_ALLOW_USER_CHOICE=true
AI_ROUTER_AUTO_MEDIA=true

# Native Gemini multimedia specialist (image, video, audio, PDF, YouTube)
AI_GEMINI_ENABLED=false
AI_GEMINI_MODEL=gemini-3.5-flash-lite
AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_GEMINI_API_KEY=
AI_GEMINI_TIMEOUT_MS=90000
AI_GEMINI_MAX_OUTPUT_CHARS=30000
AI_GEMINI_MAX_OUTPUT_TOKENS=1200
AI_GEMINI_YOUTUBE_ENABLED=true
AI_GEMINI_UPLOADS_ENABLED=true
AI_GEMINI_MAX_MEDIA_BYTES=26214400
AI_GEMINI_ALLOWED_MEDIA_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime,audio/mpeg,audio/wav,application/pdf
AI_GEMINI_INPUT_COST_PER_MILLION_TOKENS=0.30
AI_GEMINI_OUTPUT_COST_PER_MILLION_TOKENS=2.50
AI_GEMINI_SYSTEM_PROMPT=

# Public AI behavior and safety limits
AI_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_CHARS=20000
AI_MAX_OUTPUT_TOKENS=800
AI_TEMPERATURE=0.3
AI_SYSTEM_PROMPT=
AI_DAILY_USER_REQUEST_LIMIT=50
AI_DAILY_USER_TOKEN_LIMIT=100000
AI_MAX_CONCURRENT_PER_USER=1
AI_SOCKET_REQUESTS_PER_MINUTE=10

# One aggregate public-AI ceiling across OpenAI and Gemini. Each interaction
# records the selected provider's estimated token cost.
AI_MONTHLY_BUDGET_USD=10
AI_INPUT_COST_PER_MILLION_TOKENS=0.20
AI_OUTPUT_COST_PER_MILLION_TOKENS=1.25

# Privacy and learning. Uploaded media is held only for the active request.
# Conversation text is NOT stored by default.
AI_STORE_CONVERSATIONS=false
AI_LEARNING_ENABLED=true
AI_LEARNING_MIN_SCORE=2
AI_LEARNING_REQUIRE_APPROVAL=true

# Moderation: llm works with every supported primary provider; provider uses
# the provider's moderation endpoint when available.
AI_MODERATION_MODE=llm
AI_MODERATION_MODEL=

# Provider-neutral commerce foundation. Local uses CoogsNation products today;
# Shopify uses the Storefront GraphQL API when its server-side token is set.
COMMERCE_PROVIDER=local
AI_COMMERCE_CATALOG_CONTEXT_ENABLED=true
COMMERCE_SEARCH_LIMIT=8
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Optional integrations
# Safe for local/Codespaces development only. The server ignores this bypass
# when NODE_ENV=production.
RECAPTCHA_DEV_BYPASS=true
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@coogsnation.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PRINTFUL_API_KEY=
TEELAUNCH_API_KEY=
TRENDSI_API_KEY=

# Docker Compose PostgreSQL service (development/self-hosted production)
POSTGRES_USER=coogs
# Development default matches DATABASE_URL above. Replace both values with a
# strong unique password before any production deployment.
POSTGRES_PASSWORD=coogs_dev_password
POSTGRES_DB=coogsnation

# Independent database backup controls
BACKUP_RETENTION_DAYS=14
# Required for encrypted production backups created by ops/backup/backup-postgres.sh
BACKUP_ENCRYPTION_PASSPHRASE=
# Set true only for the first new self-hosted database start (development or production).
# After the initial schema exists, return this to false so only numbered SQL migrations run.
DATABASE_BOOTSTRAP=false
# Scheduled backup interval; minimum 3600 seconds.
BACKUP_INTERVAL_SECONDS=86400

# Single platform owner. Set this to Jerry's users.id after creating the owner account.
# Only this ID may grant or remove administrator access.
OWNER_USER_ID=

# Private administrator AI. This is independent from the public AI configuration.
# It is read-only and receives only a server-built, sanitized dashboard snapshot.
ADMIN_AI_ENABLED=false
ADMIN_AI_PROVIDER=openai
ADMIN_AI_MODEL=
ADMIN_AI_BASE_URL=https://api.openai.com/v1
ADMIN_AI_API_KEY=
ADMIN_AI_TIMEOUT_MS=30000
ADMIN_AI_MAX_INPUT_CHARS=3000
ADMIN_AI_MAX_OUTPUT_CHARS=12000
ADMIN_AI_MAX_OUTPUT_TOKENS=900
ADMIN_AI_TEMPERATURE=0.1
ADMIN_AI_MONTHLY_BUDGET_USD=0
ADMIN_AI_INPUT_COST_PER_MILLION_TOKENS=0
ADMIN_AI_OUTPUT_COST_PER_MILLION_TOKENS=0
ADMIN_AI_SYSTEM_PROMPT=
