# Application
NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:5000
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL development defaults
DATABASE_URL=postgresql://coogs:coogs_dev_password@localhost:5432/coogsnation
POSTGRES_HOST_PORT=5432
POSTGRES_USER=coogs
POSTGRES_PASSWORD=coogs_dev_password
POSTGRES_DB=coogsnation
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Commerce site identity. Future university fan sites use different values.
COMMERCE_SITE_KEY=coogsnation
COMMERCE_SCHOOL_KEY=houston
COMMERCE_SITE_NAME=CoogsNation
COMMERCE_SCHOOL_NAME=University of Houston
COMMERCE_CURRENCY_CODE=USD
COMMERCE_SEARCH_LIMIT=48

# Shopify direct catalog. Only products with the required approval tag publish.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_PUBLIC_STORE_DOMAIN=shop.example.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_REQUIRED_COMMERCE_TAG=coogsnation-approved

# Vetted affiliate catalog. Use one, not both.
# AFFILIATE_CATALOG_FILE=config/affiliate-catalog.json
# AFFILIATE_CATALOG_JSON=[]

# AI catalog context
AI_COMMERCE_CATALOG_CONTEXT_ENABLED=true

# ---------------------------------------------------------------------------
# Owner and administrator AI
#
# The administrator AI is deliberately configured SEPARATELY from the public
# assistant: its own enable flag, its own key, its own provider. Sharing the
# public assistant's credentials would put a read-only administrative tool on
# the same budget and rate limits as community traffic.
#
# Disabled by default. Supply a real key only when the owner enables it.
# ---------------------------------------------------------------------------
OWNER_USER_ID=
ADMIN_AI_ENABLED=false
ADMIN_AI_PROVIDER=
ADMIN_AI_API_KEY=
ADMIN_AI_MODEL=

# ---------------------------------------------------------------------------
# Public AI provider, budget, and retention
#
# AI_STORE_CONVERSATIONS is false by default: conversation text is not
# persisted unless deliberately enabled. AI_MONTHLY_BUDGET_USD caps spend;
# leave blank to use the application default.
# ---------------------------------------------------------------------------
# Master kill switch. The application reads this directly: when true, AI_MODEL
# must also be set or startup fails. Left false so a fresh install has no AI
# enabled until it is configured deliberately.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_STORE_CONVERSATIONS=false
AI_MONTHLY_BUDGET_USD=

# Custom OpenAI-compatible endpoint. Leave blank for the provider default.
AI_BASE_URL=

# Per-member daily request cap, applied on top of the monthly budget.
AI_DAILY_USER_REQUEST_LIMIT=

# Learned answers are held for administrator approval before reuse. Leaving
# this true is the safe setting: it prevents an unreviewed answer from being
# served back to the community as if it were vetted.
AI_LEARNING_REQUIRE_APPROVAL=true

# Multimedia provider. Disabled until a key is supplied.
AI_GEMINI_ENABLED=false
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=

# ---------------------------------------------------------------------------
# AI media routing
#
# When enabled, multimedia requests route to the configured media provider
# while text conversation stays with the primary provider.
# ---------------------------------------------------------------------------
AI_ROUTER_AUTO_MEDIA=true
DEV_GUEST_FULL_ACCESS=false
# NGF Sports Facts Engine
SPORTS_FACTS_ENABLED=true
# Development-only human-eye ticker demo. Never enable in production.
SPORTS_TICKER_DEMO=false
