# Core runtime
NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:5000
APP_DOMAIN=
# Configure proxy trust per host: false, true, a hop count, or a proxy subnet.
TRUST_PROXY=false

# PostgreSQL (standard PostgreSQL; works locally or with any managed provider)
# This localhost value is for manual/Codespaces development. Docker Compose
# overrides DATABASE_URL inside containers so the host becomes `database`.
# Replace it with the exact managed PostgreSQL URL in production.
DATABASE_URL=postgresql://coogs:coogs_dev_password@localhost:5432/coogsnation
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Sessions
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=coogsnation.sid

# Portable filesystem storage. Point this to a persistent mounted volume in production.
DATA_DIR=./data
UPLOADS_DIR=./data/uploads

# Optional social login providers. Email/password login works without these.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Universal AI adapter
# Supported: openai, anthropic, deepseek, xai, ollama, custom
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=
AI_BASE_URL=
# Generic key overrides provider-specific keys below.
AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
CUSTOM_AI_API_KEY=
ANTHROPIC_VERSION=2023-06-01

# AI behavior and safety limits
AI_TIMEOUT_MS=30000
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_CHARS=20000
AI_MAX_OUTPUT_TOKENS=800
AI_TEMPERATURE=0.3
AI_SYSTEM_PROMPT=
AI_DAILY_USER_REQUEST_LIMIT=50
AI_DAILY_USER_TOKEN_LIMIT=100000
AI_MAX_CONCURRENT_PER_USER=1
AI_SOCKET_REQUESTS_PER_MINUTE=10

# Cost controls. Set per-token prices for the selected provider/model.
# Monthly budget enforcement requires at least one non-zero token price.
AI_MONTHLY_BUDGET_USD=0
AI_INPUT_COST_PER_MILLION_TOKENS=0
AI_OUTPUT_COST_PER_MILLION_TOKENS=0

# Privacy and learning. Conversation content is NOT stored by default.
AI_STORE_CONVERSATIONS=false
AI_LEARNING_ENABLED=true
AI_LEARNING_MIN_SCORE=2
# Safe default: only administrator-approved answers may be reused.
AI_LEARNING_REQUIRE_APPROVAL=true

# Moderation: llm works with every supported provider; provider uses /moderations when available.
AI_MODERATION_MODE=llm
AI_MODERATION_MODEL=

# Optional integrations
RECAPTCHA_SECRET_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@coogsnation.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PRINTFUL_API_KEY=
TEELAUNCH_API_KEY=
TRENDSI_API_KEY=

# Docker Compose PostgreSQL service (development/self-hosted production)
POSTGRES_USER=coogs
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=coogsnation

# Independent database backup controls
BACKUP_RETENTION_DAYS=14
# Required for encrypted production backups created by ops/backup/backup-postgres.sh
BACKUP_ENCRYPTION_PASSPHRASE=
# Set true only for the first new self-hosted database start (development or production).
# After the initial schema exists, return this to false so only numbered SQL migrations run.
DATABASE_BOOTSTRAP=false
# Scheduled backup interval; minimum 3600 seconds.
BACKUP_INTERVAL_SECONDS=86400
